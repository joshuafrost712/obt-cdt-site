#!/usr/bin/env bash
# Pre-push gate for obt-cdt-site. Installed once per clone by `npm run hooks:install`
# (which sets core.hooksPath to .githooks). See AGENTS.md and, in the owner's vault,
# _Meta/Delivery-Contract-Protocol.md, section "Verification".
#
# What it refuses, and why:
#   1. Any pushed range that fails the participant-name scan. The scan discovers its
#      terms from a roster export outside the repo and refuses when that file is
#      absent; a scan with no population is not a green scan.
#   2. A push that touches CODE (src/ other than the content JSON, supabase/, scripts/,
#      the Vite and TypeScript config) with no spec claim held in either OBT-CDT
#      campaign, unless CDT_PUSH_UNCLAIMED="<reason>" is set, in which case the reason
#      is printed so it is in the terminal record.
#   3. A code push where no held claim's build record carries
#      `agent_verified: <sha> <date> <tier>` naming the pushed tip. The runner writes
#      that line only after the build review re-ran the proof and returned PASS.
#      "agent_verified permits the push" is this check, and it is by commit sha, not
#      by file time.
# Rounds touching only content (src/content/site-content.json, public/, docs/,
# feedback/, top-level *.md) pass the scan and skip 2 and 3, because copy and
# logistics rounds ship without a spec by campaign rule. Everything else is code.
#
# Off the owner's machine the vault is absent; the hook then runs the scan only and
# says so. Never bypass with --no-verify; fix what the hook names.

set -u

REPO="$(git rev-parse --show-toplevel)"
VAULT="${CDT_VAULT:-$HOME/Documents/Josh & Katie Vault/Claude Can Access PARA}"
CLAIMS_DIRS=("$VAULT/_Meta/runtime/spec-claims/obt-cdt-site" "$VAULT/_Meta/runtime/spec-claims/obt-cdt-assess")
SPEC_DIRS=("$VAULT/Projects/OBT/OBT Consultant Track/Site and Feedback Specs" "$VAULT/Projects/OBT/OBT Consultant Track/Intake Assessment/Specs")
ZERO="0000000000000000000000000000000000000000"

refuse() { echo "pre-push REFUSED: $*" >&2; exit 1; }

status=0
while read -r local_ref local_sha remote_ref remote_sha; do
  [ "$local_sha" = "$ZERO" ] && continue   # a branch deletion pushes nothing
  if [ "$remote_sha" = "$ZERO" ]; then
    base="$(git rev-list --max-parents=0 "$local_sha" | tail -1)"
  else
    base="$remote_sha"
  fi

  # 1. The roster name scan over the pushed range.
  if ! node "$REPO/scripts/site08-name-scan.mjs" --since "$base"; then
    refuse "participant-name scan failed or refused over $base..$local_sha"
  fi

  # Which files does this range touch? CONTENT is an allowlist; everything else is
  # code, so a workflow, hook, lockfile or config edit can never ride through as a
  # copy round. (The first version was a denylist and let .github/workflows/ and
  # this hook itself through; review 2 of the protocol caught it.)
  files="$(git diff --name-only "$base" "$local_sha")"
  code="$(printf '%s\n' "$files" | grep -Ev '^(src/content/site-content\.json$|public/|docs/|feedback/|[^/]+\.md$)' || true)"
  if [ -z "$code" ]; then
    echo "pre-push: content/docs round, scan passed, no claim required."
    continue
  fi

  if [ ! -d "$VAULT/_Meta" ]; then
    echo "pre-push: vault not found at $VAULT; scan passed, claim and proof checks skipped (not the owner's machine)." >&2
    continue
  fi

  # 2. A held claim in either campaign.
  claims=()
  for d in "${CLAIMS_DIRS[@]}"; do
    for f in "$d"/*.json; do [ -f "$f" ] && claims+=("$f"); done
  done
  if [ "${#claims[@]}" -eq 0 ]; then
    if [ -n "${CDT_PUSH_UNCLAIMED:-}" ]; then
      echo "pre-push: UNCLAIMED CODE PUSH allowed by override. Reason: $CDT_PUSH_UNCLAIMED" >&2
      continue
    fi
    refuse "code changed ($(printf '%s\n' "$code" | head -3 | tr '\n' ' ')...) with no spec claim held in obt-cdt-site or obt-cdt-assess. Claim the row, or set CDT_PUSH_UNCLAIMED=\"<reason>\" for an emergency push."
  fi

  # 3. A passed build review for the commit being pushed. Several claims can be held
  #    at once (a build row beside an audit row that builds nothing), so the rule is:
  #    SOME held claim's build record carries a line
  #        agent_verified: <sha> <date> <tier>
  #    whose <sha> is a prefix of the pushed tip. The runner writes that line only
  #    when the build review re-ran the proof and returned PASS, so the line is the
  #    review's signature on exactly these commits. A record's mtime proves nothing
  #    (any edit or touch satisfies it), and a proof heading proves the build ran,
  #    not that anyone else checked it. Claims without the line are reported.
  verified=0
  for c in "${claims[@]}"; do
    spec="$(python3 -c 'import json,sys;print(json.load(open(sys.argv[1]))["spec"])' "$c")"
    record=""
    for d in "${SPEC_DIRS[@]}"; do
      [ -f "$d/$spec-build-record.md" ] && record="$d/$spec-build-record.md"
    done
    if [ -z "$record" ]; then
      echo "pre-push: $spec claim held, no build record (not the spec being pushed, or a row that builds nothing)." >&2
      continue
    fi
    sig="$(grep -E '^agent_verified: *[0-9a-f]{7,40}' "$record" | tail -1 | awk '{print $2}')"
    if [ -z "$sig" ]; then
      echo "pre-push: $spec build record has no 'agent_verified: <sha>' line; its build review has not signed a commit." >&2
      continue
    fi
    case "$local_sha" in
      "$sig"*) echo "pre-push: $spec build review signed $sig, which is the pushed tip."; verified=1 ;;
      *) echo "pre-push: $spec build review signed $sig, but the pushed tip is ${local_sha:0:12}; commits since the review are unverified." >&2 ;;
    esac
  done
  [ "$verified" -eq 1 ] || refuse "no held claim's build record carries 'agent_verified: <tip sha>'; run the build review on these commits and record its PASS before pushing"
done

exit $status
