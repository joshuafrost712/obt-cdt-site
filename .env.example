# Member portal (docs/PORTAL.md). Copy to `.env.local` for local development;
# in CI these are repo Actions *variables*, wired in .github/workflows/deploy.yml.
#
# Both values are public. The publishable key carries the `anon` role and ships
# in the JS bundle by design — RLS decides who reads what. The service-role /
# `sb_secret_` key must NEVER appear here or anywhere in this repo.
#
# Leave either unset and the site builds exactly as it does today: no /portal
# route, no nav entry, no supabase-js in any loaded chunk.

VITE_SUPABASE_URL=https://<project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Public Google Apps Script web-app URL for the in-app feedback sink
# (see feedback/server/). Unset falls back to downloading a markdown file.
# VITE_FEEDBACK_URL=
