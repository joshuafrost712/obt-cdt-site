# dependencies / build
node_modules/
dist/
dist-ssr/
*.local

# output of scripts/diagram-preview.tsx (regenerated on demand, see docs/MEDIA.md)
.diagram-preview/

# feedback inbox — transient working artifacts, handled then moved to processed/
feedback/incoming/*
!feedback/incoming/.gitkeep
feedback/processed/*
!feedback/processed/.gitkeep
feedback/.pull.json

# generated intermediate from scripts/fetch-fonts.mjs; its content is pasted into
# src/index.css, which is the committed source of truth for the @font-face rules
scripts/fonts.generated.css

# editor
.DS_Store

# python bytecode from scripts/
__pycache__/
*.pyc

# CDT-04 UI fixture ids, written by scripts/cdt04-fixtures.mjs --setup.
# Holds fixture uuids and a throwaway fixture password; never a participant.
scripts/.cdt04-fixture-ids.json

# CDT-06a boundary-harness fixture ids, written by scripts/cdt06-fixtures.mjs --setup.
# Same rule: fixture uuids and a throwaway password, never a participant.
scripts/.cdt06-fixture-ids.json

# CDT-06a screenshots. Criterion 10 has a person open these; criterion 13 checks
# them, because a fixture name in an image is still a name in the repo.
feedback/cdt06-shots/

# Spec SITE-03. Screenshots of member pages are a disclosure channel no text gate
# can read (program finding 11): a fixture name, a base address or a schedule in an
# image is still in the repo. Six such PNGs are already tracked under
# feedback/cdt04-shots/ and are reported rather than deleted, because removing a
# file from the working tree does not remove it from a public history.
feedback/site03-shots/

# Spec SITE-04. Same reason as SITE-03's entry above, and this spec adds a second
# channel to it: a screenshot of the links register shows the register's URLs, and
# for an anyone-with-link Drive file the URL IS the credential (SITE-04 finding 5).
# So a picture of this page publishes the files it links to, in a form no text grep
# can read. Added BEFORE the first screenshot was taken, per criterion 9.
feedback/site04-shots/

# SITE-04 fixture ids, written by scripts/site04-fixtures.mjs --setup.
scripts/.site04-fixture-ids.json

# SITE-04's Drive permission report. It names file ids, so it is written to the
# private vault beside the register (finding 5) and never committed here; this
# entry exists so a stray --report path cannot land the report in a public repo.
scripts/.site04-link-report.json

# Screenshots of member pages, taken by scripts/verify-member-access.mjs against
# REAL participant accounts. Program finding 11: an image is a disclosure channel
# that no text gate can read, and these ones photograph a live cohort's page.
feedback/verify-shots/

# Spec SITE-06's shots. The public page's own screenshots are harmless, but the
# nav ones are taken SIGNED IN with a real participant account and show the
# member entries. Program finding 11: an image is a disclosure channel no text
# gate can read.
feedback/site06-shots/
